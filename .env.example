# ── Kings Collectables environment variables ────────────────────────────────
# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# REQUIRED — PostgreSQL connection string for installed/boostrapped Postgres.
DATABASE_URL=postgresql://kings_user:your_db_password@localhost:5432/kings_store

# STRONGLY RECOMMENDED — password-protects /admin, the POS register and price sync.
# If unset, the owner workspace is open to anyone who finds the URL.
ADMIN_PASSWORD=

# STRONGLY RECOMMENDED — signs owner + customer session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# OPTIONAL — secret for the daily market-price sync cron job. Generate with:
#   openssl rand -hex 16
# Then add to the VPS crontab (crontab -e):
#   0 3 * * * curl -fsS "http://127.0.0.1:3000/api/cron/prices?key=YOUR_CRON_SECRET" >> /var/log/kings-pricing.log 2>&1
# Without it, scheduled price updates stay disabled; "Update prices now" still works in the workspace.
CRON_SECRET=

# OPTIONAL — TCGplayer market prices for the daily sync.
# Free with an approved TCGplayer developer account: apply at developer.tcgplayer.com
# (under "My Apps" → public + private keys). When both are set, the Pricing tab's
# "Automatic" source prices cards live from TCGplayer; without them it uses Scryfall,
# whose USD prices are themselves TCGplayer's market price. Scryfall still supplies
# the card→productId mapping, so nothing else changes.
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# OPTIONAL — Stripe card payments (leave blank for Bank Transfer only checkout).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Set automatically by the runtime; do not configure manually.
# NODE_ENV=production
